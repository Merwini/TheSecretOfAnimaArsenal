{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Source/TheSecretOfAnimaArsenal/TheSecretOfAnimaArsenal.csproj",
                "--configuration",
                "Release",
                "-p:Platform=AnyCPU",
                "-p:DebugSymbols=false",
                "-p:DebugType=none"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
