	<RecipeDef ParentName="AmmoRecipeNeolithicBase">
		<defName>MakeTSOA_Ammo_Arrow_Anima</defName>
		<label>make screamer arrows x10</label>
		<description>Craft 10 screamer arrows.</description>
		<jobString>Making screamer arrows.</jobString>
		<workAmount>200</workAmount>
		<researchPrerequisite>TSOA_AnimaOne</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>WoodLog</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>TSOA_AnimaGrassResource</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>WoodLog</li>
				<li>TSOA_AnimaGrassResource</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<TSOA_Ammo_Arrow_Anima>10</TSOA_Ammo_Arrow_Anima>
		</products>
	</RecipeDef>
	
