<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<CombatExtended.AmmoCategoryDef>
		<defName>TSOA_AnimaArrowCategory</defName>
		<label>screamer arrow</label>
		<description>Wrapped with anima grass and infused with psychic energy, releases a miniature psychic scream on impact that reduces humans' moods and makes wild animals turn manhunter.</description>
		<advanced>true</advanced>
	</CombatExtended.AmmoCategoryDef>

	<!-- Ammoset -->
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_AnimaBowArrow</defName>
		<label>arrows</label>
		<ammoTypes>
			<Ammo_Arrow_Stone>TSOA_Projectile_AnimaBowArrow_Stone</Ammo_Arrow_Stone>
			<Ammo_Arrow_Steel>TSOA_Projectile_AnimaBowArrow_Steel</Ammo_Arrow_Steel>
			<Ammo_Arrow_Plasteel>TSOA_Projectile_AnimaBowArrow_Plasteel</Ammo_Arrow_Plasteel>
			<Ammo_Arrow_Venom>TSOA_Projectile_AnimaBowArrow_Venom</Ammo_Arrow_Venom>
			<Ammo_Arrow_Flame>TSOA_Projectile_AnimaBowArrow_Flame</Ammo_Arrow_Flame>
			<TSOA_Ammo_Arrow_Anima>TSOA_Projectile_ArrowBowArrow_Anima</TSOA_Ammo_Arrow_Anima>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- Arrow ThingDef -->
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="AmmoArrowBase">
		<defName>TSOA_Ammo_Arrow_Anima</defName>
		<label>arrow (screamer)</label>
		<graphicData>
			<texPath>TSOA/Things/Ammo/AnimaArrow</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.018</Mass>
		</statBases>
		<ammoClass>TSOA_AnimaArrowCategory</ammoClass>
		<generateAllowChance>0.05</generateAllowChance>
	</ThingDef>

	<ThingDef Name="TSOA_BaseAnimaBowArrowProjectile" ParentName="BaseBulletCE" Abstract="true">
		<graphicData>
			<texPath>Things/Projectile/Arrow_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>ArrowHighVelocity</damageDef>
			<speed>46</speed>
			<secondaryDamage>
				<li>
					<def>TSOA_EntropyExtraDamage</def>
					<amount>1</amount>
				</li>
			</secondaryDamage>
		</projectile>
		<modExtensions>
			<li Class="tsoa.arsenal.EntropyDamageExtension">
				<damageDef>TSOA_EntropicDischarge</damageDef>
				<entropyCountedFlat>1</entropyCountedFlat>
				<entropySpentFlat>-4</entropySpentFlat>
				<damagePerEntropy>8</damagePerEntropy>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="TSOA_BaseAnimaBowArrowProjectile">
		<defName>TSOA_Projectile_AnimaBowArrow_Stone</defName>
		<label>anima bow arrow (stone)</label>
		<graphicData>
			<texPath>Things/Projectile/Arrows/Arrow_Stone</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>40</speed>
			<damageAmountBase>8</damageAmountBase>
			<armorPenetrationSharp>0.5</armorPenetrationSharp>
			<armorPenetrationBlunt>2.78</armorPenetrationBlunt>
			<preExplosionSpawnChance>0.2</preExplosionSpawnChance>
			<preExplosionSpawnThingDef>Ammo_Arrow_Stone</preExplosionSpawnThingDef>
		</projectile>
		<modExtensions>
			<li Class="ProjectileImpactFX.EffectProjectileExtension">
				<AutoAssign>false</AutoAssign>
				<CreateTerrainEffects>true</CreateTerrainEffects>
				<StuckProjectileFleckDef>Fleck_CELandedArrow_Stone</StuckProjectileFleckDef>
				<StuckProjectileFleckSize>0.65</StuckProjectileFleckSize>
			</li>
		</modExtensions>
	</ThingDef>

