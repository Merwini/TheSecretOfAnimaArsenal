<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{95521467-5537-4FE8-A769-0F72AB9E5AE8}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>tsoa.arsenal</RootNamespace>
    <AssemblyName>TheSecretOfAnimaArsenal</AssemblyName>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>14.0</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)/../../../..</RimWorldDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RimWorldVersion>1.6</RimWorldVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RimWorldVersion>1.7</RimWorldVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' != ''">
    <OutputPath>..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TheSecretOfAnimaCore">
      <HintPath>..\..\..\TheSecretOfAnimaCore\1.7\Assemblies\TheSecretOfAnimaCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateModReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TargetFramework)' == 'net10.0' And !Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="RimWorld 1.7 assemblies not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' And !Exists('$(RimWorldDir)/UnityStubs.dll')" Text="RimWorld 1.7 UnityStubs.dll not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../../TheSecretOfAnimaCore/$(RimWorldVersion)/Assemblies/TheSecretOfAnimaCore.dll')" Text="TheSecretOfAnimaCore reference not found for RimWorld $(RimWorldVersion). Build that version of TheSecretOfAnimaCore first." />
  </Target>
</Project>
