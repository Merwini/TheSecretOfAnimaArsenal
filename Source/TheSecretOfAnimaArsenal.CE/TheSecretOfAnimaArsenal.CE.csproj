<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>TheSecretOfAnimaArsenal.CE</AssemblyName>
    <RootNamespace>tsoa.arsenal.ce</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)/../../../..</RimWorldDir>
    <CombatExtendedDir Condition="'$(CombatExtendedDir)' == ''">$(RimWorldDir)/../../workshop/content/294100/2890901044</CombatExtendedDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RimWorldVersion>1.6</RimWorldVersion>
    <CombatExtendedDll Condition="'$(CombatExtendedDll)' == '' And '$(CombatExtended16Dll)' != ''">$(CombatExtended16Dll)</CombatExtendedDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RimWorldVersion>1.7</RimWorldVersion>
    <CombatExtendedDll Condition="'$(CombatExtendedDll)' == '' And '$(CombatExtended17Dll)' != ''">$(CombatExtended17Dll)</CombatExtendedDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' != ''">
    <OutputPath>../../ModCompat/CE/$(RimWorldVersion)/Assemblies/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <CombatExtendedDll Condition="'$(CombatExtendedDll)' == '' And Exists('$(CombatExtendedDir)/$(RimWorldVersion)/Assemblies/CombatExtended.dll')">$(CombatExtendedDir)/$(RimWorldVersion)/Assemblies/CombatExtended.dll</CombatExtendedDll>
    <CombatExtendedDll Condition="'$(CombatExtendedDll)' == ''">$(CombatExtendedDir)/Assemblies/CombatExtended.dll</CombatExtendedDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TheSecretOfAnimaArsenal/TheSecretOfAnimaArsenal.csproj" Private="false" />
    <Reference Include="CombatExtended">
      <HintPath>$(CombatExtendedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateCEReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CombatExtendedDll)')" Text="CombatExtended.dll was not found for RimWorld $(RimWorldVersion). Set CombatExtendedDll, or the matching CombatExtended16Dll/CombatExtended17Dll property, to the full path of the matching CE assembly." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' And (!Exists('$(RimWorldDir)/Assembly-CSharp.dll') Or !Exists('$(RimWorldDir)/UnityStubs.dll') Or !Exists('$(RimWorldDir)/Waylith.dll'))" Text="RimWorld 1.7 assemblies were not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
  </Target>
</Project>
