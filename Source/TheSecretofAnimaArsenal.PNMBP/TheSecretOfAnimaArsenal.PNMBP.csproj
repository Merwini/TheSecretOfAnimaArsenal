<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>TheSecretOfAnimaArsenal.PNMBP</AssemblyName>
    <RootNamespace>tsoa.arsenal.pnmbp</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)/../../../..</RimWorldDir>
    <PNMBPDir Condition="'$(PNMBPDir)' == ''">$(RimWorldDir)/../../workshop/content/294100/2739055353</PNMBPDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <RimWorldVersion>1.6</RimWorldVersion>
    <PNMBPDll Condition="'$(PNMBPDll)' == '' And '$(PNMBP16Dll)' != ''">$(PNMBP16Dll)</PNMBPDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <RimWorldVersion>1.7</RimWorldVersion>
    <PNMBPDll Condition="'$(PNMBPDll)' == '' And '$(PNMBP17Dll)' != ''">$(PNMBP17Dll)</PNMBPDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' != ''">
    <OutputPath>../../ModCompat/PNMBP/$(RimWorldVersion)/Assemblies/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <PNMBPDll Condition="'$(PNMBPDll)' == ''">$(PNMBPDir)/$(RimWorldVersion)/Assemblies/ProstheticNoMissingBodyParts.dll</PNMBPDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TheSecretOfAnimaArsenal/TheSecretOfAnimaArsenal.csproj" Private="false" />
    <Reference Include="ProstheticNoMissingBodyParts">
      <HintPath>$(PNMBPDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony">
      <Version>2.4.2</Version>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="ValidatePNMBPReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PNMBPDll)')" Text="ProstheticNoMissingBodyParts.dll was not found for RimWorld $(RimWorldVersion). Set PNMBPDll, or the matching PNMBP16Dll/PNMBP17Dll property, to the full path of the matching PNMBP assembly." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' And (!Exists('$(RimWorldDir)/Assembly-CSharp.dll') Or !Exists('$(RimWorldDir)/UnityStubs.dll') Or !Exists('$(RimWorldDir)/Waylith.dll'))" Text="RimWorld 1.7 assemblies were not found. Set RimWorldDir to your RimWorld 1.7 installation using -p:RimWorldDir=... ." />
  </Target>
</Project>
